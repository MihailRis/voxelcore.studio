<panel size-func="unpack(gui.get_viewport())" orientation="horizontal" color='0'>
    <panel id="sideToolbar" size="48" color='0' padding='10,6,6,6'>
    </panel>
    <splitbox size-func="-53,-1" id="editorRoot" orientation="horizontal" split-pos="0.3">
        <splitbox split-pos="0.5">
            <iframe id='left_panel' />
            <panel id="locals"
                color="#00000030"
                padding="5,15,5,15">
            </panel>
        </splitbox>
        <splitbox id="editorContainer" split-pos="0.8">
            <container color='0' interval='0'>
                <panel id="tabsPanel" size-func="-1,30" color='#00000010' orientation='horizontal'
                    padding='2' interval='2'>
                </panel>
                <iframe id="editorPanel" src="dev:code_panel" pos="0,32" size-func="-1,-32" />
            </container>
            <splitbox orientation="horizontal" split-pos="0.4">
                <panel id="traceback" padding="4" color="#000000A0">
                </panel>
                <textbox id="output"
                    padding="4"
                    editable="false"
                    markup="md"
                    multiline="true"
                    color="#000000A0">
                </textbox>
            </splitbox>
        </splitbox>
    </splitbox>
</panel>
